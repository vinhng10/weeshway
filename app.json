{
  "expo": {
    "name": "WeeshWay",
    "slug": "weeshway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weeshway",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "App requires microphone access to detect wake words and transcribe speech.",
        "NSSpeechRecognitionUsageDescription": "App transcribes your speech to text when you start listening."
      },
      "bundleIdentifier": "com.weeshway.weeshway"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C0C0C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.weeshway.weeshway",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-speech-recognition",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/MomoTrustDisplay-Regular.ttf"]
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.weeshway.weeshway",
          "enableGooglePay": true
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90a2d6ca-dbb8-495f-beb6-63d81d1cdf79"
      }
    },
    "owner": "weeshway-ai"
  }
}
