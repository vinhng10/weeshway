{
  "expo": {
    "name": "WeeshWay",
    "slug": "weeshway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weeshway",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.weeshway.weeshway",
      "associatedDomains": ["applinks:weeshway.com"],
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.in-app-payments": [
          "merchant.com.weeshway.weeshway"
        ],
        "com.apple.developer.associated-domains": ["applinks:weeshway.com"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C0C0C"
      },
      "package": "com.weeshway.weeshway",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "weeshway.com",
              "pathPrefix": "/classes"
            },
            {
              "scheme": "https",
              "host": "weeshway.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "weeshway.com",
              "pathPrefix": "/teacher"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C0C",
          "image": "./assets/images/icon.png",
          "imageWidth": 250
        }
      ],
      "expo-router",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow access to microphone to record audio for dance class teaching."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-speech-recognition",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/MomoTrustDisplay-Regular.ttf"]
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.weeshway.weeshway",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Turning on location will allow us to show you nearby dance classes and wishes.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow access to camera to scan booking QR codes and capture photos as evidence for reports."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to set cover images for your dance classes.",
          "cameraPermission": "Allow access to camera to scan booking QR codes and capture photos as evidence for reports."
        }
      ],
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://weeshway.com"
      },
      "eas": {
        "projectId": "f38505f5-6a7b-4b86-b2b2-af6895ef72c7"
      }
    },
    "owner": "weeshway"
  }
}
